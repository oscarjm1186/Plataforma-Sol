# This application is 100% client-side (SPA) and operates completely offline/standalone.
# No Gemini API Key or external secrets are required for running or deploying to Netlify.

# (Optional) GEMINI_API_KEY: Not required. All study content, guides, exams, and flashcards are bundled locally.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
